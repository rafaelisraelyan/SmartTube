<?xml version="1.0" encoding="utf-8"?>
<!--
    GRTubeYou: the focus highlight that replaced the pressed card.

    The row used to show a filled rounded card (comments_bg_pressed) when focused. A fill is
    wrong for a flat list - it puts the very weight back that the redesign removes - so focus
    is a hairline outline instead, at 1dp with no corner radius: a ring around the row, not a
    block behind it. No state list is needed because this drawable is only ever set as the
    focused background by the holder; a resting row has no background at all.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/comment_focus" />
</shape>
