<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="exo_media_button_height">60dp</dimen>
    <dimen name="exo_media_button_width">60dp</dimen>
    <dimen name="exo_media_button_margin">8dp</dimen>
    <dimen name="exo_media_button_padding">4dp</dimen>
    <dimen name="player_main_padding">50dp</dimen>
    <dimen name="player_second_padding">25dp</dimen>
    <dimen name="player_top_bar_text_size">20sp</dimen>
    <dimen name="player_top_bar_text_size2">14sp</dimen>
    <dimen name="player_time_bar_height">4dp</dimen>
    <dimen name="player_time_bar_text_size">14sp</dimen>
    <dimen name="player_time_bar_scrubber_size">12sp</dimen>
    <dimen name="player_time_bar_scrubber_dragged_size">16dp</dimen>
    <dimen name="progress_bar_size">70dp</dimen>
    <dimen name="debug_text_size">12sp</dimen>
    <dimen name="player_suggestions_height">50dp</dimen>
    <dimen name="subtitle_text_size">30sp</dimen>
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <!--
        GRTubeYou: metrics for the flat comment row.

        Sized off the reference rather than picked by eye. The row used to be a 40dp avatar
        beside a card padded 10/10 inside a list that already carried 16dp of left margin
        and 3dp of right, so one comment took far more height than its text needed. What
        follows trims that: a smaller avatar, no card, generous vertical air between rows
        instead, and a single-line action row.

        Horizontal insets are left alone - 16dp is the dialog's own padding, inherited from
        the list, and narrowing it would push the avatar into the window edge.
    -->
    <!-- The row's own left inset. Everything else measures from here. -->
    <dimen name="comment_row_indent">16dp</dimen>

    <!-- Avatar, top level comment. Smaller than the old 40dp: with no card around it the
         avatar reads as a marker rather than as the head of a block. -->
    <dimen name="comment_avatar_size">34dp</dimen>

    <!--
        Nesting. Each level is indented by comment_depth_step and its avatar is comment_avatar_shrink
        smaller, down to comment_avatar_min. Measured off the reference, where the root avatar
        is about 1.3x a level-1 avatar and the indent between them is a little over one root
        avatar wide.

        The shrink has a floor on purpose: past a point a shrinking avatar stops reading as
        an avatar and starts reading as a smudge, and YouTube itself nests three deep at most.
    -->
    <dimen name="comment_depth_step">22dp</dimen>
    <dimen name="comment_avatar_shrink">5dp</dimen>
    <dimen name="comment_avatar_min">24dp</dimen>

    <!-- Radius of the turn where a thread line meets the elbow going to the avatar. -->
    <dimen name="comment_thread_elbow">10dp</dimen>

    <!-- Gap between the avatar and the text column. -->
    <dimen name="comment_gutter">10dp</dimen>

    <!-- Vertical air between comments. This is what separates the rows now that the card
         is gone, so it is deliberately more generous than the old 10dp bottom margin. -->
    <dimen name="comment_row_margin_top">14dp</dimen>
    <dimen name="comment_row_margin_bottom">2dp</dimen>

    <!--
        A root comment in an open thread gets more air under it than a reply does, so the
        branch it heads is a visual block rather than one more row. The reference leaves a
        clear gap between the root's action row and the first reply.
    -->
    <dimen name="comment_root_margin_bottom">18dp</dimen>

    <!--
        Author name size. A root comment gets the larger one: inside an open thread it is the
        heading of the branch, and a size difference is the cheapest way to say that without
        putting a box around it. In the flat list every row is a root, so they all match.
    -->
    <dimen name="comment_author_size_root">15sp</dimen>
    <dimen name="comment_author_size_reply">14sp</dimen>

    <!-- Author line to body. -->
    <dimen name="comment_author_margin_bottom">3dp</dimen>

    <!-- Action row: thumbs, count, 'Reply'. -->
    <dimen name="comment_action_margin_top">5dp</dimen>
    <dimen name="comment_icon_size">17dp</dimen>
    <dimen name="comment_icon_gap">5dp</dimen>
    <!-- Gap between the vote group and the 'Reply' label. -->
    <dimen name="comment_action_gap">14dp</dimen>

    <!-- The 'N replies' row and its chevron. -->
    <dimen name="comment_replies_margin_top">5dp</dimen>
    <dimen name="comment_replies_gap">6dp</dimen>
    <dimen name="comment_chevron_size">14dp</dimen>

    <!--
        The thread line: 1dp, and deliberately almost invisible (comment_thread_line is
        #26FFFFFF). It is there to show that a reply hangs off something, not to draw a box.
    -->
    <dimen name="comment_thread_width">1dp</dimen>
</resources>
