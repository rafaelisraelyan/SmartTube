<!--
    GRTubeYou: the flat comment row, with real thread nesting.

    What it replaced: a 40dp avatar beside a FlexboxLayout filled with comments_bg (#303030)
    and rounded 15dp on every corner, with author, vote count, timestamp and reply count
    mashed into one bold line inside it. That reads as a chat bubble.

    What it is now - one flat list on the dialog background, with the nesting carried by
    indentation and hairline connectors rather than by boxes:

        |  @andre...  1 день назад            <- depth 0, the anchor, no line of its own
        |  ТОЛЬКО ОНИ ПОНЯЛИ STEAM FRAME!
        |  (thumb) 758  (thumb)  Ответить
        |_
        |   |  @exe_xddd123  1 день назад     <- depth 1: spine + elbow from the root's line
        |   |  Не понял только Игорь Линк
        |   |_
        |   |   |  @andre...  19 часов назад  <- depth 2: its own line inside the root's
        |   |   |  @exe_xddd123 только после Шевцова)

    Three things are deliberate here:

    - There is no card, no background and no border on a resting row. comment_row_background
      is a state list whose only non-transparent state is state_focused, so a ring appears
      under the D-pad and nowhere else. The earlier version applied a stroked shape to every
      row, which boxed every comment.

    - The connectors are one view (CommentThreadLinesView) that paints a line per ancestor
      level, not a nest of positioned children. A row at level 4 needs four lines; four
      nested views per row is four times the view count for every comment in the list.

    - The avatar's left offset and size are set in code from the row's depth, so the geometry
      the lines are drawn with and the geometry the avatar is laid out with come from the same
      source. If they were two sets of numbers the elbow would stop in mid-air.

    chatkit's BaseIncomingMessageViewHolder needs @id/messageUserAvatar and tolerates a
    missing @id/messageTime, which is deliberate: the timestamp is bound to commentTime so it
    can share the author line in a muted colour.
-->
<com.stfalcon.chatkit.commons.widgets.FocusFixRelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/comment_row_margin_top"
    android:layout_marginBottom="@dimen/comment_row_margin_bottom"
    android:background="@drawable/comment_row_background"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingStart="@dimen/comment_row_indent"
    android:paddingEnd="@dimen/comment_row_indent">

    <!--
        Connectors. Spans the row, so the outermost line runs unbroken down the thread.
        Draws nothing at depth 0 - the anchor has no line above it. Set by the holder.
    -->
    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.chat.CommentThreadLinesView
        android:id="@+id/commentThreadLines"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.stfalcon.chatkit.utils.ShapeImageView
        android:id="@id/messageUserAvatar"
        android:layout_width="@dimen/comment_avatar_size"
        android:layout_height="@dimen/comment_avatar_size"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="@dimen/comment_gutter"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/commentContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/messageUserAvatar"
        android:layout_toRightOf="@id/messageUserAvatar"
        android:orientation="vertical">

        <!-- Author line: name and time side by side, as in the reference. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/comment_author_margin_bottom"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/commentAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/comment_author"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/commentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/comment_meta"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
            Body. lineSpacingMultiplier is 1.0, not the 0.9 the card used: at this size 0.9
            pulled consecutive lines tight enough to hurt a long comment. The old
            maxLines="50" is kept - it guards a real RecyclerView bug, not a style choice.
        -->
        <TextView
            android:id="@+id/commentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.0"
            android:maxLines="50"
            android:textColor="@color/comment_text"
            android:textSize="15sp" />

        <!--
            Action row. The thumbs are real buttons: on a TV there is no long press, so an
            explicit control is the only way to vote.
        -->
        <LinearLayout
            android:id="@+id/commentActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/comment_action_margin_top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/commentLikeIcon"
                android:layout_width="@dimen/comment_icon_size"
                android:layout_height="@dimen/comment_icon_size"
                android:background="@null"
                android:contentDescription="@string/comment_action_like"
                android:focusable="true"
                android:src="@drawable/comment_thumb_up" />

            <TextView
                android:id="@+id/commentLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/comment_icon_gap"
                android:textColor="@color/comment_meta"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/commentDislikeIcon"
                android:layout_width="@dimen/comment_icon_size"
                android:layout_height="@dimen/comment_icon_size"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:contentDescription="@string/comment_action_dislike"
                android:focusable="true"
                android:src="@drawable/comment_thumb_down" />

            <TextView
                android:id="@+id/commentReplyAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/comment_action_gap"
                android:focusable="true"
                android:text="@string/comment_action_reply"
                android:textColor="@color/comment_action"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
            Reply row. Focusable and clickable, and wired to the same handler instance the
            comment body uses, so there is one path for opening a thread.
        -->
        <LinearLayout
            android:id="@+id/commentRepliesRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/comment_replies_margin_top"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/commentRepliesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/comment_action"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/commentRepliesChevron"
                android:layout_width="@dimen/comment_chevron_size"
                android:layout_height="@dimen/comment_chevron_size"
                android:layout_marginStart="@dimen/comment_replies_gap"
                android:background="@null"
                android:contentDescription="@null"
                android:src="@drawable/comment_chevron_down" />
        </LinearLayout>
    </LinearLayout>
</com.stfalcon.chatkit.commons.widgets.FocusFixRelativeLayout>
